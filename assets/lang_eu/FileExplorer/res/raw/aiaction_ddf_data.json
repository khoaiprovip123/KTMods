  "modules": {
    "iid": 1,
    "type": "urn:aiot-spec-v3:com.mi.phones:module:[com.android.fileexplorer]:0:1.0",
    "description": "fileexplorer",
    "name": "com.android.fileexplorer",
    "services": {
      "iid": 1,
      "type": "urn:aiot-spec-v3:com.mi.phones:service:[com.android.fileexplorer/file]:0:1.0",
      "description": "fileexplorer service",
      "name": "fileexplorer",
      "actions": [
        {
          "type": "urn:aiot-spec-v3:com.mi.phones:action:[com.android.fileexplorer/file/searchByFileName]:0:1.0",
          "description": "根据文件名查找",
          "in": [
            {
              "name":"file_name",
              "value": "文件名",
              "format": "string"
            }
          ],
          "out": [
            {
              "name": "status",
              "value": "执行状态",
              "format": "uint32",
              "value-list": [
                {"value": 0, "description": "执行成功"},
                {"value": -1, "description": "执行失败"}
              ]
            }
          ]
        },
        {
          "type": "urn:aiot-spec-v3:com.mi.phones:action:[com.android.fileexplorer/file/searchByCategory]:0:1.0",
          "description": "根据分类和文件名查找",
          "in": [
            {
              "name":"file_name",
              "description": "文件名",
              "format": "string"
            },
            {
              "name":"category",
              "description": "文件类型",
              "valueList": [
                {"value": "doc", "description": "文档类型"},
                {"value": "video", "description": "视频类型"},
                {"value": "picture", "description": "图片类型"},
                {"value": "music", "description": "音乐类型"},
                {"value": "zip", "description": "压缩包类型"},
                {"value": "apk", "description": "应用程序类型"},
                {"value": "folder", "description": "文件夹类型"}
              ]
            }
          ],
          "out": [
            {
              "name": "status",
              "description": "执行状态",
              "format": "uint32",
              "value-list": [
                {"value": 0, "description": "执行成功"},
                {"value": -1, "description": "执行失败"}
              ]
            }
          ]
        },
        {
          "type": "urn:aiot-spec-v3:com.mi.phones:action:[com.android.fileexplorer/file/searchByAppName]:0:1.0",
