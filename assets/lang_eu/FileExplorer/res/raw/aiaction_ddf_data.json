            {
              "name":"file_name",
              "description": "文件名",
              "format": "string"
            },
            {
              "name":"package_name",
              "description": "应用包名",
              "valueList": [
                {"value": "com.tencent.mm", "description": "微信"},
                {"value": "com.tencent.mobileqq", "description": "QQ"},
                {"value": "com.sina.weibo", "description": "微博"},
                {"value": "com.baidu.netdisk", "description": "百度网盘"},
                {"value": "com.ss.android.lark", "description": "飞书"}
              ]
            }
          ],
          "out": [
            {
              "name": "status",
              "description": "执行状态",
              "format": "uint32",
              "value-list": [
                {"value": 0, "description": "执行成功"},
                {"value": -1, "description": "执行失败"}
              ]
            }
          ]
        },
        {
          "type": "urn:aiot-spec-v3:com.mi.phones:action:[com.android.fileexplorer/file/openFile]:0:1.0",
          "description": "打开文件",
          "in": [
            {
              "name":"file_id",
              "description": "文件在列表中的位置",
              "format": "int32"
            }

          ],
          "out": [
            {
              "name": "status",
              "description": "执行状态",
              "format": "uint32",
              "value-list": [
                {"value": 0, "description": "执行成功"},
