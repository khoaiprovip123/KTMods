# rom-kitchen config — lisa HyperOS China
# Chạy: .\build.ps1 -RomUrl "<link hoặc đường dẫn OTA>"

# --- Device ---
device=lisa
device_name=Mi 11 Lite 5G NE
android=14

# --- Super layout (KHÔNG đổi — khớp partition máy) ---
super_device_size=9126805504
super_metadata_size=65536
super_metadata_slots=3
super_virtual_ab=1
super_name=super
super_group_size=9126805504

# --- Features ---
install_toolbox=true          # Kaorios Toolbox (không root)
install_mods=true             # thay APK từ assets/apks
disable_signature=true        # bypass chữ ký app
disable_secure_flag=true      # chụp/ghi màn app banking/DRM
cn_notification_fix=true      # hết trễ thông báo ROM China
add_vietnamese=true           # ghép values-vi từ rom_lang

# --- Paths ---
apk_dir=assets/apks
kaorios_dir=assets/kaorios
lang_dir=assets/lang          # values-vi từ ROM Global
tools_dir=tools
out_dir=out

# --- Output ---
rom_name=LISA_OS_MOD
compress=7z
